# ===== Slack（必須）=====
# OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxx
# Basic Information → App-Level Tokens（scope: connections:write）
SLACK_APP_TOKEN=xapp-xxxxxxxxxx
# 出欠を投稿するチャンネルのID（チャンネル名を右クリック → リンクをコピー の末尾 C... ）
NOTIFY_CHANNEL_ID=C0123456789

# ===== ステータス自動変更（OAuth）用 =====
# Basic Information → App Credentials
SLACK_CLIENT_ID=1234567890.1234567890
SLACK_CLIENT_SECRET=xxxxxxxxxxxxxxxx
# このサーバーに https で届くURL（ngrok など）。メンバーが /lab connect するときだけ必要
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app

# ===== カメラ班・canvas班との共有キー（必須）=====
# 例: python -c "import secrets; print(secrets.token_urlsafe(32))" で生成
CAMERA_API_KEY=change-me
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# ===== 任意 =====
DB_PATH=lab_presence.db
TIMEZONE=Asia/Tokyo
STATUS_IN_TEXT=出席中（研究室）
STATUS_IN_EMOJI=:large_green_circle:
STATUS_OUT_TEXT=退席中
STATUS_OUT_EMOJI=:white_circle:
# true: 本人が手動で設定したステータス（会議中など）は上書きしない
RESPECT_CUSTOM_STATUS=true
