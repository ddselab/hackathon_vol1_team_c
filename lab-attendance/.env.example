# cp .env.example .env でコピーして値を入れる。.env はコミットしないこと
# systemd が読むので、export や引用符（"）は付けずに「名前=値」だけを書く
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
PHOTO_CHANNEL=
